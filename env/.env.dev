# Variables del entorno dev de Agents Toolkit. Este archivo va a git y el repo es público: no poner secretos ni URLs de la fiscalía.

TEAMSFX_ENV=dev
# Vacío para que el agente se llame "Penalisto" a secas
APP_NAME_SUFFIX=
AGENT_SCOPE=shared

# Fijo para que cada paquete nuevo sustituya al anterior en vez de crear otro agente
TEAMS_APP_ID=158db874-ca97-461e-9dfc-a1e1943f4ee4
# La GitHub Action pone 1.0.<n.º de ejecución>
APP_VERSION=1.0.0

# URL de la carpeta de OneDrive o SharePoint con el material común (ADR 0003).
# No se escribe aquí: va en la variable MATERIAL_COMUN_URL de GitHub o en el entorno.
# Sin ella el agente buscaría en todo su OneDrive y mezclaría Asuntos.
MATERIAL_COMUN_URL=
